# Copy to .streamlit/secrets.toml (git-ignored) or paste into your host's secrets manager.
# Never commit the real file. The app reads this server-side only; the URL is never sent
# to the browser.

[aarambh]
# Google Sheet holding DATE + NIFTY50_PE + predictors. Share it as "Anyone with the link
# can view", or File → Share → Publish to web (a /d/e/2PACX-… link also works).
google_sheets_url = "https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit#gid=0"

# Alternative: set the environment variable AARAMBH_GOOGLE_SHEETS_URL instead.
